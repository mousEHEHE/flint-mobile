<?xml version="1.0" encoding="utf-8" ?>
<!-- Adapted from gpui-mobile's example. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Vulkan when there is one, OpenGL ES 3 otherwise. -->
    <uses-feature android:name="android.hardware.vulkan.level" android:required="false" android:version="0" />
    <uses-feature android:name="android.hardware.vulkan.version" android:required="false" android:version="0x00401000" />
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="Flint"
        android:supportsRtl="true"
        android:theme="@style/FlintTheme"
    >
        <!-- Rotation and the keyboard must not recreate the activity and the session with it. -->
        <activity
            android:name="dev.gpui.mobile.GpuiActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation|uiMode|density"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="unspecified"
            android:theme="@style/FlintSplashTheme"
            android:windowSoftInputMode="adjustResize"
        >
            <meta-data android:name="android.app.lib_name" android:value="${nativeLibraryName}" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- flint://signed-in: the sign-in page sends the browser back to the app. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="flint" />
            </intent-filter>
        </activity>

        <!-- gpui-mobile's helpers for file prompts, permissions and biometrics. -->
        <activity
            android:name="dev.gpui.mobile.GpuiPathPicker"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation|uiMode|density"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
        />
        <activity
            android:name="dev.gpui.mobile.GpuiPickerActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
        />
        <activity
            android:name="dev.gpui.mobile.GpuiPermissionActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
        />
        <activity
            android:name="dev.gpui.mobile.GpuiAuthActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
        />
    </application>
</manifest>
